# Command-line tools managed by Homebrew instead of Nix: standalone tools
# with no shell or system integration, where upstream moves fast. Everything
# else stays in the Nix config (see "Homebrew" in README.md).
#
# Applied only when you run `brew-update` ([b] in the `update` menu): it
# shows missing and outdated formulas, and installed ones not listed here,
# then installs, upgrades and uninstalls to match this file if you say yes.
# After editing: commit, `rebuild`, then `brew-update`.

brew "yt-dlp"      # breaks when sites change; needs fast updates
brew "gh"          # GitHub CLI
brew "glab"        # GitLab CLI
brew "ripgrep"     # rg
brew "fd"
brew "bat"
brew "jq"
brew "yq"
brew "television"  # tv, fuzzy finder
brew "dysk"        # disk usage overview
brew "trash-cli"
brew "tealdeer"    # tldr
brew "shellcheck"
brew "stress-ng"
